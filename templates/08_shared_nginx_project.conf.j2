server {
    listen 80;
    listen [::]:80;

    server_name {{ shared_domain }};

    root {{ shared_nginx_app_root }}/public;
    index index.php index.html;
    charset utf-8;

    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;

    access_log /dev/stdout;
    error_log /dev/stderr warn;

    client_max_body_size 100m;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }

    location = /robots.txt {
        access_log off;
        log_not_found off;
    }

    location ~ \.php$ {
        try_files $uri =404;

        set $php_backend "{{ shared_php_alias }}:9000";

        include fastcgi_params;
        fastcgi_pass $php_backend;
        fastcgi_index index.php;

        fastcgi_param SCRIPT_FILENAME "{{ shared_php_app_root }}/public$fastcgi_script_name";
        fastcgi_param DOCUMENT_ROOT "{{ shared_php_app_root }}/public";
        fastcgi_param SCRIPT_NAME $fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";

        fastcgi_connect_timeout 10s;
        fastcgi_send_timeout 60s;
        fastcgi_read_timeout 60s;
    }

    location ~ /\.ht {
        deny all;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}

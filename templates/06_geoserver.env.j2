GS_VERSION={{ gs_version }}
GS_IMAGE_NAME={{ gs_image_name }}
GS_CONTAINER_NAME={{ gs_container_name }}
GS_BIND_ADDRESS=127.0.0.1
GS_HOST_PORT={{ gs_host_port }}
GS_PROXY_NETWORK={{ gs_proxy_network }}
GS_REMOVE_GT_COMPLEX={{ 'true' if gs_remove_gt_complex_enabled else 'false' }}

GS_SKIP_DEMO_DATA={{ 'true' if gs_skip_demo_data else 'false' }}
GS_INSTALL_EXTENSIONS={{ 'true' if gs_install_extensions else 'false' }}
GS_STABLE_EXTENSIONS={{ gs_extension_csv }}

GS_EXTRA_JAVA_OPTS={{ gs_extra_java_opts | to_json }}
GS_RUN_UNPRIVILEGED=true
GS_RUN_WITH_USER_UID={{ gs_run_uid }}
GS_RUN_WITH_USER_GID={{ gs_run_gid }}

GS_PROXY_BASE_URL={{ ('https://' + gs_domain + '/geoserver') | to_json }}
GS_PROXY_BASE_URL_HEADERS=true
GS_ROOT_WEBAPP_REDIRECT=true

GS_CORS_ENABLED=true
GS_CORS_ALLOWED_METHODS={{ gs_cors_allowed_methods | to_json }}
GS_CORS_ALLOWED_HEADERS={{ gs_cors_allowed_headers | to_json }}
GS_CORS_ALLOWED_ORIGINS={{ gs_effective_cors_origins | to_json }}
GS_CORS_ALLOW_CREDENTIALS=true
{% if gs_manage_admin_credentials %}
GS_ADMIN_USER='{{ gs_admin_user | replace("'", "\\'") }}'
GS_ADMIN_PASSWORD='{{ gs_admin_password | replace("'", "\\'") }}'
{% endif %}

GS_CPU_LIMIT={{ gs_cpu_limit }}
GS_MEMORY_LIMIT={{ gs_memory_limit }}
GS_MEMORY_RESERVATION={{ gs_memory_reservation }}

services:
  shared-nginx:
    image: nginx:1.26-alpine
    container_name: {{ shared_nginx_container }}
    restart: unless-stopped

    expose:
      - "80"

    volumes:
      - ./nginx/conf.d:/etc/nginx/conf.d:ro
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro

    security_opt:
      - no-new-privileges:true

    tmpfs:
      - /var/cache/nginx
      - /var/run
      - /run
      - /tmp

    networks:
      - npm-network
      - shared-web

networks:
  npm-network:
    external: true

  shared-web:
    external: true

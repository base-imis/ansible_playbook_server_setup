# Add this to the NPM Proxy Host Advanced configuration.
# Basic upstream: http://{{ gs_container_name }}:8080

location = /geoserver/web {
{% for ip in gs_admin_allowed_list %}    allow {{ ip }};
{% endfor %}    deny all;
    return 301 /geoserver/web/;
}
location ^~ /geoserver/web/ {
{% for ip in gs_admin_allowed_list %}    allow {{ ip }};
{% endfor %}    deny all;
    proxy_pass http://{{ gs_container_name }}:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
}
location = /geoserver/rest {
{% for ip in gs_admin_allowed_list %}    allow {{ ip }};
{% endfor %}    deny all;
    return 301 /geoserver/rest/;
}
location ^~ /geoserver/rest/ {
{% for ip in gs_admin_allowed_list %}    allow {{ ip }};
{% endfor %}    deny all;
    proxy_pass http://{{ gs_container_name }}:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
}
location ~ ^/geoserver/([^/]+/)?(wms|wfs|wcs|wmts|ows)(/|$) {
    proxy_pass http://{{ gs_container_name }}:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
}
location ^~ /geoserver/ {
    return 403;
}
